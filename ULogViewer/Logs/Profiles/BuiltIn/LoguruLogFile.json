{
	"AllowMultipleFiles": true,
	"DataSource": {
		"Name": "File"
	},
	"ColorIndicator": "None",
	"Icon": "Log",
	"LogLevelMapForReading": {
		"CRITICAL": "Fatal",
		"DEBUG": "Debug",
		"ERROR": "Error",
		"INFO": "Info",
		"SUCCESS": "Info",
		"TRACE": "Trace",
		"WARNING": "Warn"
	},
	"LogPatterns": [
		{
			"Regex": "^(?<Timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}( [\\+\\-]\\d{2}:\\d{2})?) \\| (?<Extra2>\\S+)\\s*\\| (?<SourceName>\\S+) - (?<Message>.*)$"
		},
		{
			"Regex": "^(?!\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}( [\\+\\-]\\d{2}:\\d{2})? \\| )(\\s*$|(?<Message>.*))",
			"IsRepeatable": true,
			"IsSkippable": true
		}
	],
	"LogWritingFormats": [
		"{Timestamp} | {Extra2} | {SourceName} - {Message}"
	],
	"RawLogLevelPropertyName": "Extra2",
	"SortDirection": "Ascending",
	"SortKey": "Timestamp",
	"TimestampCategoryGranularity": "Minute",
	"TimestampCultureInfoForReading": "en-US",
	"TimestampEncodingForReading": "Custom",
	"TimestampFormatForDisplaying": "yyyy/MM/dd HH:mm:ss.fff",
	"TimestampFormatForWriting": "yyyy-MM-dd HH:mm:ss.fff zzz",
	"TimestampFormatsForReading": [
		"yyyy-MM-dd HH:mm:ss.fff zzz",
		"yyyy-MM-dd HH:mm:ss.fff"
	],
	"VisibleLogProperties": [
		{
			"Name": "Timestamp",
			"Width": 200
		},
		{
			"Name": "SourceName",
			"Width": 250
		},
		{
			"Name": "Message"
		}
	]
}
