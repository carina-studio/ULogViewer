{
	"AllowMultipleFiles": true,
	"DataSource": {
		"Name": "File"
	},
	"ColorIndicator": "None",
	"Icon": "Server",
	"LogLevelMapForReading": {
		"alert": "Error",
		"crit": "Fatal",
		"debug": "Debug",
		"emerg": "Fatal",
		"error": "Error",
		"info": "Info",
		"notice": "Info",
		"warn": "Warn"
	},
	"LogPatterns": [
		{
			"Regex": "^(?<Timestamp>\\d{4}/\\d{2}/\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+\\[(?<Extra5>[a-z]+)\\]\\s+(?<ProcessId>\\d+)#(?<ThreadId>\\d+):\\s+(\\*(?<Extra2>\\d+)\\s+)?(?<Message>.*?)(,\\s+(?<Message>client:\\s+(?<Extra1>[^,]*)(,\\s+server:\\s+(?<Extra6>[^,]*))?(,\\s+request:\\s+\"((?<Extra3>[A-Z]+)\\s+(?<Extra4>[^\\s\"]+)[^\"]*|[^\"]*)\")?.*))?$"
		},
		{
			"Regex": "^(?!\\d{4}/\\d{2}/\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+\\[)(\\s*$|(?<Message>.*))",
			"IsRepeatable": true,
			"IsSkippable": true
		}
	],
	"LogWritingFormats": [
		"{Timestamp} [{Extra5}] {ProcessId}#{ThreadId}: *{Extra2} {Message}",
		"{Timestamp} [{Extra5}] {ProcessId}#{ThreadId}: {Message}"
	],
	"RawLogLevelPropertyName": "Extra5",
	"SortDirection": "Ascending",
	"SortKey": "Timestamp",
	"TimestampCategoryGranularity": "Minute",
	"TimestampCultureInfoForReading": "en-US",
	"TimestampEncodingForReading": "Custom",
	"TimestampFormatForDisplaying": "yyyy/MM/dd HH:mm:ss",
	"TimestampFormatForWriting": "yyyy/MM/dd HH:mm:ss",
	"TimestampFormatsForReading": [
		"yyyy'/'MM'/'dd HH:mm:ss"
	],
	"VisibleLogProperties": [
		{
			"Name": "Timestamp",
			"Width": 160
		},
		{
			"Name": "ProcessId",
			"Width": 70
		},
		{
			"DisplayName": "Connection",
			"Name": "Extra2",
			"Width": 90
		},
		{
			"DisplayName": "Client",
			"Name": "Extra1",
			"Width": 120
		},
		{
			"DisplayName": "Server",
			"Name": "Extra6",
			"Width": 140
		},
		{
			"DisplayName": "Method",
			"Name": "Extra3",
			"Width": 70
		},
		{
			"DisplayName": "Path",
			"Name": "Extra4",
			"Width": 200
		},
		{
			"Name": "Message"
		}
	]
}
