{
	"AllowMultipleFiles": true,
	"DataSource": {
		"Name": "File"
	},
	"ColorIndicator": "None",
	"Icon": "Intelligence",
	"LogLevelMapForReading": {
		"DEBUG": "Debug",
		"ERROR": "Error",
		"INFO": "Info",
		"TRACE": "Trace",
		"WARN": "Warn",
		"WARNING": "Warn"
	},
	"LogPatterns": [
		{
			"Regex": "^\\[(?<Timestamp>\\d{4}\\-\\d{2}\\-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})\\]\\[(?<Level>\\w+)\\](\\[(?<SourceName>[^\\]=]+)\\])?(\\[Client=(?<Extra1>[^\\]]*)\\])?(\\[Endpoint=(?<Extra2>[^\\]]*)\\])?\\s?(?<Message>(Received\\s+request:\\s+(?<Extra3>[A-Z]+)\\s+to\\s+(?<Extra4>\\S+))?.*)$"
		},
		{
			"Regex": "^(?!\\[\\d{4}\\-\\d{2}\\-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}\\]\\[)(\\s*$|(?<Message>.*))",
			"IsRepeatable": true,
			"IsSkippable": true
		}
	],
	"LogWritingFormats": [
		"[{Timestamp}][{Level}][{SourceName}] {Message}",
		"[{Timestamp}][{Level}] {Message}"
	],
	"SortDirection": "Ascending",
	"SortKey": "Timestamp",
	"TimestampCategoryGranularity": "Minute",
	"TimestampEncodingForReading": "Custom",
	"TimestampFormatForDisplaying": "yyyy/MM/dd HH:mm:ss",
	"TimestampFormatForWriting": "yyyy-MM-dd HH:mm:ss",
	"TimestampFormatsForReading": [
		"yyyy-MM-dd HH:mm:ss"
	],
	"VisibleLogProperties": [
		{
			"Name": "Timestamp",
			"Width": 160
		},
		{
			"Name": "SourceName",
			"Width": 180
		},
		{
			"DisplayName": "Client",
			"Name": "Extra1",
			"Width": 180
		},
		{
			"DisplayName": "EndPoint",
			"Name": "Extra2",
			"Width": 120
		},
		{
			"DisplayName": "Method",
			"Name": "Extra3",
			"Width": 80
		},
		{
			"DisplayName": "Path",
			"Name": "Extra4",
			"Width": 200
		},
		{
			"Name": "Message"
		}
	]
}
