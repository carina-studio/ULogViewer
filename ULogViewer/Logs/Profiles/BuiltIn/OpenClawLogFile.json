{
	"AllowMultipleFiles": true,
	"DataSource": {
		"Name": "File"
	},
	"ColorIndicator": "None",
	"Icon": "Agent",
	"LogLevelMapForReading": {
		"DEBUG": "Debug",
		"ERROR": "Error",
		"FATAL": "Fatal",
		"INFO": "Info",
		"SILLY": "Verbose",
		"TRACE": "Trace",
		"WARN": "Warn"
	},
	"LogPatterns": [
		{
			"Regex": "^\\{.*?\"_meta\":\\{.*?\"logLevelName\":\"(?<Extra2>[A-Z]+)\",\"name\":\"(openclaw|\\{\\\\\"(subsystem|module)\\\\\":\\\\\"(?<SourceName>(\\\\\\\\.|[^\"\\\\])*?)\\\\\"(\\\\.|[^\"\\\\])*|(?<SourceName>(\\\\.|[^\"\\\\])*))\".*?\\},\"time\":\"(?<Timestamp>[^\"]+)\",\"hostname\":\"(\\\\.|[^\"\\\\])*\"(,\"message\":\"(?<Message>(\\\\.|[^\"\\\\])*)\")?(?=(.*?,\"agent_id\":\"(?<Extra1>(\\\\.|[^\"\\\\])*)\")?)(?=(.*?,\"session_id\":\"(?<Extra3>(\\\\.|[^\"\\\\])*)\")?)(?=(.*?,\"channel\":\"(?<Extra4>(\\\\.|[^\"\\\\])*)\")?)"
		}
	],
	"LogWritingFormats": [
		"{Timestamp} {Extra2} {SourceName} {Message}",
		"{Timestamp} {Extra2} {Message}"
	],
	"RawLogLevelPropertyName": "Extra2",
	"SortDirection": "Ascending",
	"SortKey": "Timestamp",
	"TimestampCategoryGranularity": "Minute",
	"TimestampCultureInfoForReading": "en-US",
	"TimestampEncodingForReading": "Custom",
	"TimestampFormatForDisplaying": "yyyy/MM/dd HH:mm:ss.fff",
	"TimestampFormatForWriting": "yyyy-MM-dd'T'HH:mm:ss.fffK",
	"TimestampFormatsForReading": [
		"yyyy-MM-dd'T'HH:mm:ss.fffK"
	],
	"VisibleLogProperties": [
		{
			"Name": "Timestamp",
			"Width": 200
		},
		{
			"DisplayName": "SubSystem",
			"Name": "SourceName",
			"Width": 200
		},
		{
			"DisplayName": "Agent",
			"Name": "Extra1",
			"Width": 120
		},
		{
			"DisplayName": "Session",
			"Name": "Extra3",
			"Width": 200
		},
		{
			"DisplayName": "Channel",
			"Name": "Extra4",
			"Width": 100
		},
		{
			"Name": "Message"
		}
	]
}
