<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

	<!-- Common -->
	<sys:String x:Key="String/Common.Administrator">Superuser</sys:String>
	
<!-- ExternalDependency-->
<sys:String x:Key="String/ExternalDependency.LibIMobileDevice.Description">'Apple Devices Log' および 'Specific Apple Device Log' 組み込みログプロファイルは、libimobiledevice の一部である idevicesyslog ツールを使用してデバイスに接続し、ログを取得します。パッケージマネージャーで libimobiledevice をインストールしなかった場合は、インストール後に 'idevicesyslog' コマンドを含むフォルダーのパスを PATH 環境変数に追加してください。</sys:String>

	
	<!-- ScriptEditor -->
	<sys:String x:Key="String/ScriptEditor.DefaultFontFamilies">Noto Sans Mono CJK TC,Noto Sans Mono CJK TS</sys:String>
	<sys:String x:Key="String/ScriptEditor.DefaultFontFamilies.CJK">Noto Sans Mono CJK TC,Noto Sans Mono CJK TS</sys:String>

	<!-- SessionView -->
	<sys:String x:Key="String/SessionView.RestartAsAdministrator">スーパーユーザーとして再起動</sys:String>
	<sys:String x:Key="String/SessionView.ShowFileInExplorer">ファイルマネージャーでファイルを表示</sys:String>
	<sys:String x:Key="String/SessionView.ShowWorkingDirectoryInExplorer">ファイルマネージャーで作業ディレクトリを表示</sys:String>
	
</ResourceDictionary>
