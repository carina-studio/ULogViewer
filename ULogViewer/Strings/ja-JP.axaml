    <sys:String x:Key="String/BuiltInProfile.LinuxKernelLogFile.Description">Linux からのカーネルログを含むファイル。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.LinuxRealtimeLog">Linux リアルタイムシステム全体ログ</sys:String>
    <sys:String x:Key="String/BuiltInProfile.LinuxRealtimeLog.Description">Linux からのリアルタイムシステム全体のログ。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.LinuxSystemLog">Linux システムログ (Debian/Ubuntu)</sys:String>
