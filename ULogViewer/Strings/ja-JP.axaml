    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.ClosingReaderScript">Raw ログリーダーを閉じるスクリプト</sys:String>
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.ClosingReaderScript.Description">このスクリプトはRaw ログリーダーを閉じる際に 1回実行されます。戻り値は不要です。</sys:String>
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.ClosingReaderScript.Template.CSharp_13">
        /*
        * ログ読込用に型は自動的にインポートされます (例 : FileStream)。
        * 詳細については https://carinastudio.net/Scripting
        * および https://carinastudio.net/ULogViewer/ScriptLogDataSource を参照してください。
        */
    </sys:String>
    <StaticResource x:Key="String/ScriptLogDataSourceProviderEditorDialog.ClosingReaderScript.Template.CSharp_14"
                    ResourceKey="String/ScriptLogDataSourceProviderEditorDialog.ClosingReaderScript.Template.CSharp_13" />
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.ClosingReaderScript.Template.JavaScript_ES_5_1">
        /*
        * ログ読込用に型は自動的にインポートされます (例 : FileStream)。
        * 詳細については https://carinastudio.net/Scripting
        * および https://carinastudio.net/ULogViewer/ScriptLogDataSource を参照してください。
        */
    </sys:String>
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.ClosingReaderScript.Template.Python_3_4">
        # ログ読込用に型は自動的にインポートされます (例 : FileStream)。
        # 詳細については https://carinastudio.net/Scripting
        # および https://carinastudio.net/ULogViewer/ScriptLogDataSource を参照してください。
    </sys:String>
    <StaticResourceExtension
        x:Key="String/ScriptLogDataSourceProviderEditorDialog.ConfirmApplyingWithCompilationErrors"
        ResourceKey="String/LogAnalysisScriptSetEditorDialog.ConfirmApplyingWithCompilationErrors" />
    <StaticResourceExtension x:Key="String/ScriptLogDataSourceProviderEditorDialog.ConfirmClosingWithCompilationErrors"
                             ResourceKey="String/LogAnalysisScriptSetEditorDialog.ConfirmClosingWithCompilationErrors" />
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.DisplayName">名前</sys:String>
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.OpeningReaderScript">Raw ログリーダーを開くスクリプト</sys:String>
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.OpeningReaderScript.Description">このスクリプトはRaw ログリーダーを開く際に 1回実行されます。戻り値は、成功した場合は LogDataSourceState.ReaderOpened、失敗の場合はその他の値とします。</sys:String>
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.OpeningReaderScript.Template.CSharp_13">
        /*
        * ログ読込用に型は自動的にインポートされます (例 : FileStream、LogDataSourceState)。
        * 詳細については https://carinastudio.net/Scripting
        * および https://carinastudio.net/ULogViewer/ScriptLogDataSource を参照してください。
        */

        /*
        * リーダーが正常に開かれた場合は LogDataSourceState.ReaderOpened を返します。
        * または、失敗の場合は以下の値のいずれかを返します:
        *   * LogDataSourceState.ExternalDependencyNotFound
        *   * LogDataSourceState.SourceNotFound
        *   * LogDataSourceState.UnclassifiedError
        */
        return LogDataSourceState.UnclassifiedError;
    </sys:String>
    <StaticResource x:Key="String/ScriptLogDataSourceProviderEditorDialog.OpeningReaderScript.Template.CSharp_14"
                    ResourceKey="String/ScriptLogDataSourceProviderEditorDialog.OpeningReaderScript.Template.CSharp_13" />
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.OpeningReaderScript.Template.JavaScript_ES_5_1">
        /*
        * ログ読込用に型は自動的にインポートされます (例: FileStream、LogDataSourceState)。
        * 詳細については https://carinastudio.net/Scripting
        * および https://carinastudio.net/ULogViewer/ScriptLogDataSource を参照してください。
        */

        /*
        * リーダーが正常に開かれた場合は LogDataSourceState.readerOpened を返します。
        * または、失敗の場合は以下の値のいずれかを返します :
        *   * LogDataSourceState.externalDependencyNotFound
        *   * LogDataSourceState.sourceNotFound
        *   * LogDataSourceState.unclassifiedError
        */
        return LogDataSourceState.unclassifiedError;
    </sys:String>
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.OpeningReaderScript.Template.Python_3_4">
        # ログ読込用に型は自動的にインポートされます (例: FileStream、LogDataSourceState)。
        # 詳細については https://carinastudio.net/Scripting
        # および https://carinastudio.net/ULogViewer/ScriptLogDataSource を参照してください。

        # リーダーが正常に開かれた場合は LogDataSourceState.ReaderOpened を返します。
        # または、失敗の場合は以下の値のいずれかを返します :
        #   * LogDataSourceState.ExternalDependencyNotFound
        #   * LogDataSourceState.SourceNotFound
        #   * LogDataSourceState.UnclassifiedError
        return LogDataSourceState.UnclassifiedError
    </sys:String>
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.ReadingLineScript">Raw ログ行を読み取るスクリプト</sys:String>
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.ReadingLineScript.Description">このスクリプトは Raw ログ行を読み取るために実行されます。戻り値は String または Null とします。</sys:String>
    <sys:String x:Key="String/ScriptLogDataSourceProviderEditorDialog.ReadingLineScript.Template.CSharp_13">
        /*
        * ログ読込用に型は自動的にインポートされます (例 : FileStream)。
        * 詳細については https://carinastudio.net/Scripting
        * および https://carinastudio.net/ULogViewer/ScriptLogDataSource を参照してください。
        */

        /*
        * ソースから読み取った Raw ログ行 (文字列)を返すか、読み取る行がこれ以上ない場合は Null を返します。
        */
        return null;
