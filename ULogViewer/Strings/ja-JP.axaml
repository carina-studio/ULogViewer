<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Accuracy -->
    <sys:String x:Key="String/Accuracy.High">高精度</sys:String>
    <sys:String x:Key="String/Accuracy.Low">低精度</sys:String>
    <sys:String x:Key="String/Accuracy.Normal">標準</sys:String>

    <!-- App -->
    <sys:String x:Key="String/App.Shutdown">終了</sys:String>

    <!-- AppOptionsDialog -->
    <sys:String x:Key="String/AppOptionsDialog.ClearLogTextFilterPhrasesDatabase">フレーズデータベースをクリア</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.ClearLogTextFilterPhrasesDatabase.Result">データベースから {0} 個のフレーズをクリアしました。</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.ConfirmMaxLogReadingCountForLargeFiles">大容量ファイル追加時に読み込む最大ログ数を確認する</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.ContinuousLogReadingUpdateInterval">継続読込中のログ更新間隔 (ミリ秒)</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.DefaultTextShell">コマンド実行時のデフォルトコマンドラインシェル</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.EnableLogTextFilterPhraseInputAssistance">テキストフィルタでのフレーズ入力補助</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.EnableLogTextFilterPhraseInputAssistance.Description">テキストフィルタの履歴に基づいてフレーズ入力を補助します。</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.EnableScrollingToLatestLogAfterReloadingLogs">ログ再読込後に最新ログまでスクロール</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.EnableScrollingToLatestLogAfterReloadingLogs.Description">継続的なログ読み込み中にのみ適用されます。</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.FileSizeInMBToConfirmMaxLogReadingCount">大容量ファイルとみなすファイルサイズ (MB)</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.IgnoreCaseOfLogTextFilter">テキストフィルタのデフォルトで大文字小文字を区別しない</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.InitialLogProfile">起動時の初期ログプロファイル</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.LogAnalysis">ログ分析</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.LogFiltering">ログフィルタリング</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.LogFont">ログのフォントとサイズ</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.LogFont.Sample">サンプルログテキスト 123</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.LogOperations">ログ操作</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.LogSeparators">ログ区切り文字</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.MaxContinuousLogCount">継続読込中の最大ログ数</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.MaxDisplayLineCountForEachLog">ログごとの最大表示行数</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.MemoryUsagePolicy">メモリ使用ポリシー</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.PatternFont">パターンフォント</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.PatternFont.Description">正規表現、日時形式、時間間隔形式など、すべてのパターンに適用されます。</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.PatternFont.Sample">サンプル [0-9] \s \d HH:mm:ss</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.PhysicalMemoryUsagePercentageToStopReadingLogs">メモリ使用量制限 ({0}、{1}%)</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.PhysicalMemoryUsagePercentageToStopReadingLogs.Description">プロセスのメモリ使用量が制限を超えると、ログ読み込みが一時的に無効になります。</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.ProVersionOnly">Pro バージョンへのアップグレードが必要です。</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.ResetLogAnalysisRuleSetsAfterSettingLogProfile">ログプロファイル変更後に適用中のルールセットをリセット</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.ScriptEditorFont">スクリプトエディタのフォントとサイズ</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.ScriptEditorFont.Sample">
        if (x == 0) {
        Context.Logger.LogDebug(msg);
        }
    </sys:String>
    <sys:String x:Key="String/AppOptionsDialog.SelectCommandWhenNeeded">コマンドが必要な場合は入力ダイアログを表示</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.SelectInitialLogProfile">プロファイルを選択</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.SelectIPEndPointWhenNeeded">IP エンドポイントが必要な場合は入力ダイアログを表示</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.SelectLogFilesWhenNeeded">ファイルが必要な場合はファイル選択ダイアログを表示</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.SelectLogReadingPreconditionForFiles">ファイルからのログ読み込み時に利用可能な場合は事前条件を設定</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.SelectProcessIdWhenNeeded">プロセスID (PID)が必要な場合は入力ダイアログを表示</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.SelectProcessNameWhenNeeded">プロセス名が必要な場合は入力ダイアログを表示</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.SelectUriWhenNeeded">URI が必要な場合は入力ダイアログを表示</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.SelectWorkingDirectoryWhenNeeded">作業ディレクトリが必要な場合はディレクトリ選択ダイアログを表示</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.SessionInitLogProfileSelectionMode">新規タブのログプロファイル選択方法</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.ShowHelpButtonOnLogTextFilter">テキストフィルタ入力欄に「ヘルプ」ボタンを表示</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.ShowLogChartPanelIfDefined">チャートパネルを自動表示</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.ShowLogChartPanelIfDefined.Description">ログプロファイルでチャートが定義されている場合にパネルを表示します。</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.ShowProcessInfo">ステータスバーに CPU/メモリ使用量を表示</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.SwitchToMarkedLogsPanelAfterMarkingLogs">ログマーク後に「マークされたログ」パネルに切り替え</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.UpdateLogFilterDelay">条件変更からフィルタリング開始までの遅延 (ミリ秒)</sys:String>
    <sys:String x:Key="String/AppOptionsDialog.UseSystemAccentColor">システムのアクセントカラーを適用</sys:String>

    <!-- Azure -->
    <sys:String x:Key="String/Azure.AzureCliNotFound">Azure CLI が見つかりません。インストールされており、そのパスが PATH 環境変数に追加されていることを確認してください。</sys:String>
    <sys:String x:Key="String/Azure.FailedExecuteAzureCli">Azure CLI を実行できませんでした。</sys:String>
    <sys:String x:Key="String/Azure.FailedToLogin">Azure にログインできませんでした。</sys:String>
    <sys:String x:Key="String/Azure.LoggedIn">ユーザー「{0}」で Azure にログインしました。</sys:String>
    <sys:String x:Key="String/Azure.LoggedOut">Azure からログアウトしました。</sys:String>

    <!-- AzureCliLogDataSourceProvider -->
    <sys:String x:Key="String/AzureCliLogDataSourceProvider.DisplayName">Azure CLI</sys:String>

    <!-- AzureResourcesDialog -->
    <sys:String x:Key="String/AzureResourcesDialog.DoubleClickToSelectName">項目をダブルクリックしてリソースを使用</sys:String>
    <sys:String x:Key="String/AzureResourcesDialog.Title">Azure 上のリソース</sys:String>

    <!-- Built-in profile -->
    <sys:String x:Key="String/BuiltInProfile.AndroidDeviceEventLog">Android デバイス イベントログ</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidDeviceEventLog.Description">ADB 経由の Android デバイスからのリアルタイム イベントログ。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidDeviceLog">Android デバイスログ</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidDeviceLog.Description">ADB 経由の Android デバイスからのリアルタイムログ。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidDeviceTrace">Android デバイスシステムトレース</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidDeviceTrace.Description">Android デバイスから 5 秒間のシステムトレースをキャプチャし、システムおよびアプリケーションのパフォーマンスを分析します。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidFileLog">Android ログファイル</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidFileLog.Description">1 つ以上のファイルに保存された Android ログ。このプロファイルはイベントログもサポートします。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidKernelLogFile">Android カーネルログファイル</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidKernelLogFile.Description">1 つ以上のファイルに保存された Android カーネルログ。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidProcessMemoryInfo">Android プロセスメモリモニター</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidProcessMemoryInfo.Description">特定の Android プロセスのリアルタイムメモリ情報。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidSystemMemoryInfo">Android システムメモリモニター</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidSystemMemoryInfo.Description">Android システムのリアルタイムシステムメモリ情報。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidTraceFile">Android システムトレースファイル</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AndroidTraceFile.Description">システムトレースファイル (*.html)を解析して、Android デバイス上のシステムおよびアプリケーションのパフォーマンスを分析します。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.ApacheAccessLogFile">Apache アクセスログファイル</sys:String>
    <sys:String x:Key="String/BuiltInProfile.ApacheAccessLogFile.Description">Apache によって生成された、Web サーバーが受信したリクエストに関する情報を含むファイル。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.ApacheErrorLogFile">Apache エラーログファイル</sys:String>
    <sys:String x:Key="String/BuiltInProfile.ApacheErrorLogFile.Description">Apache によって生成された、Web サーバーが遭遇したエラーに関する情報を含むファイル。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AppleDevicesLog">Apple デバイスログ</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AppleDevicesLog.Description">接続されている Apple デバイスからのリアルタイムシステム全体のログ。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AzureWebappLogFile">Azure Web アプリログファイル</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AzureWebappLogFile.Description">Azure からダウンロードした Web アプリケーションログファイル。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AzureWebappLogStream">Azure Web アプリログストリーム</sys:String>
    <sys:String x:Key="String/BuiltInProfile.AzureWebappLogStream.Description">Azure 上の特定の Web アプリケーションのリアルタイムログストリーム。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.BootedAppleDeviceSimulatorsRealtimeLog">Apple デバイスシミュレータログ</sys:String>
    <sys:String x:Key="String/BuiltInProfile.BootedAppleDeviceSimulatorsRealtimeLog.Description">起動中のすべての Apple デバイスシミュレータからのリアルタイムシステム全体のログ。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.Empty">なし</sys:String>
    <sys:String x:Key="String/BuiltInProfile.GitLog">Git ログ</sys:String>
    <sys:String x:Key="String/BuiltInProfile.GitLog.Description">指定されたリポジトリからの Git コミットの一覧。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.GitLogSimple">Git ログ (簡易)</sys:String>
