    <!-- LogAnalysisScriptSetEditorDialog -->
    <sys:String x:Key="String/LogAnalysisScriptSetEditorDialog.AnalysisScript">ログ分析スクリプト</sys:String>
    <sys:String x:Key="String/LogAnalysisScriptSetEditorDialog.AnalysisScript.Description">このスクリプトは各ログに対して分析のために実行されます。戻り値は、そのログの分析結果を含めるかどうかを示すブール値です。</sys:String>
    <sys:String x:Key="String/LogAnalysisScriptSetEditorDialog.AnalysisScript.Template.CSharp_13">
        /*
        * ログ分析用に型は自動的にインポートされます (例: ILog、ResultType)。
        * 詳細については https://carinastudio.net/Scripting
        * および https://carinastudio.net/ULogViewer/LogAnalysis#LogAnalysisScript を参照してください。
        */

        /*
        * Context.AddResult() で追加された結果を含める場合は True を返し、
        * 現在のログと結果をスキップする場合は False を返します。
        */
        return false;
    </sys:String>
    <StaticResource x:Key="String/LogAnalysisScriptSetEditorDialog.AnalysisScript.Template.CSharp_14"
                    ResourceKey="String/LogAnalysisScriptSetEditorDialog.AnalysisScript.Template.CSharp_13" />
    <sys:String x:Key="String/LogAnalysisScriptSetEditorDialog.AnalysisScript.Template.JavaScript_ES_5_1">
        /*
        * ログ分析用に型は自動的にインポートされます (例: ILog、ResultType)。
        * 詳細については https://carinastudio.net/Scripting
        * および https://carinastudio.net/ULogViewer/LogAnalysis#LogAnalysisScript を参照してください。
        */

        /*
        * context.addResult() で追加された結果を含める場合は True を返し、
        * 現在のログと結果をスキップする場合は False を返します。
        */
        return false;
    </sys:String>
    <sys:String x:Key="String/LogAnalysisScriptSetEditorDialog.AnalysisScript.Template.Python_3_4">
        # ログ分析用に型は自動的にインポートされます (例: ILog、ResultType)。
        # 詳細については https://carinastudio.net/Scripting
        # および https://carinastudio.net/ULogViewer/LogAnalysis#LogAnalysisScript を参照してください。

        # context.AddResult() で追加された結果を含める場合は True を返し、
        # 現在のログと結果をスキップする場合は False を返します。
        return False
    </sys:String>
