    <sys:String x:Key="String/BuiltInProfile.LinuxSystemLogFile.Description">Linux からのシステムログを含むファイル。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.MacOSInstallationLog">macOS インストールログ</sys:String>
    <sys:String x:Key="String/BuiltInProfile.MacOSInstallationLog.Description">macOS からのインストールログ。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.MacOSRealtimeLog">macOS リアルタイムシステム全体ログ</sys:String>
    <sys:String x:Key="String/BuiltInProfile.MacOSRealtimeLog.Description">macOS からのリアルタイムシステム全体のログ。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.MacOSSystemLogFile">macOS システムログファイル</sys:String>
    <sys:String x:Key="String/BuiltInProfile.MacOSSystemLogFile.Description">macOS からのシステムログを含むファイル。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.RawFile">ファイル内の Raw テキスト</sys:String>
    <sys:String x:Key="String/BuiltInProfile.RawFile.Description">解析せずに 1 つ以上のファイルから Raw テキストを読み取ります。通常はテストおよびデバッグ用に使用されます。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.RawHttp">Raw HTTP/HTTPS レスポンス</sys:String>
    <sys:String x:Key="String/BuiltInProfile.RawHttp.Description">HTTP/HTTPS リクエストを送信し、レスポンスから Raw テキストを解析せずに読み取ります。通常はテストおよびデバッグ用に使用されます。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.RawStandardOutput">標準出力 (stdout)からの Raw テキスト</sys:String>
    <sys:String x:Key="String/BuiltInProfile.RawStandardOutput.Description">コマンドを実行し、その標準出力 (stdout)および標準エラー (stderr)から Raw テキストを読み取ります。通常はテストおよびデバッグ用に使用されます。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.RawTcpServer">TCP クライアントからの Raw テキスト</sys:String>
    <sys:String x:Key="String/BuiltInProfile.RawTcpServer.Description">TCP サーバーを起動し、クライアントから Raw テキストを解析せずに読み取ります。通常はテストおよびデバッグ用に使用されます。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.SpecificAndroidDeviceEventLog">特定 Android デバイスイベントログ</sys:String>
    <sys:String x:Key="String/BuiltInProfile.SpecificAndroidDeviceEventLog.Description">ADB 経由の特定 Android デバイスからのリアルタイムイベントログ。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.SpecificAndroidDeviceLog">特定 Android デバイスログ</sys:String>
    <sys:String x:Key="String/BuiltInProfile.SpecificAndroidDeviceLog.Description">ADB 経由の特定 Android デバイスからのリアルタイムログ。</sys:String>
    <sys:String x:Key="String/BuiltInProfile.SpecificAndroidDeviceTrace">特定 Android デバイスシステムトレース</sys:String>
