    <sys:String x:Key="String/BuiltInProfile.ULogViewerMemoryLog">ULogViewer リアルタイムログ</sys:String>
    <sys:String x:Key="String/BuiltInProfile.ULogViewerMemoryLog.Description">メモリ内の ULogViewer からのリアルタイムログ。</sys:String>
